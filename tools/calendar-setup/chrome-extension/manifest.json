{
  "manifest_version": 3,
  "name": "Family Hub Calendar Setup",
  "version": "1.0.0",
  "description": "Connect Google Calendar accounts to your Family Hub workspace",

  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://accounts.google.com/*",
    "https://www.googleapis.com/*",
    "http://localhost:3457/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Family Hub Calendar Setup"
  },

  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "service-worker.js"
  }
}
