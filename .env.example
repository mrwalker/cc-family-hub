# Where your family workspace lives (default: ./workspace).
# Point it at a private repo to version your family data there.
# HUB_WORKSPACE=../my-family-hub/workspace

# Where secrets.yaml and google-service-account.json live (default: <workspace>/state).
# Keep them outside any git repo, especially when the workspace is versioned:
#   mkdir -p ~/.config/family-hub && chmod 700 ~/.config/family-hub
# HUB_SECRETS_DIR=~/.config/family-hub
