# Copy to .env (gitignored). Read by the family-hub command.

# Where secrets.yaml and google-service-account.json live. Keep them outside every repo:
#   mkdir -p ~/.config/family-hub && chmod 700 ~/.config/family-hub
HUB_SECRETS_DIR=~/.config/family-hub

# The workspace, if not ./workspace
# HUB_WORKSPACE=./workspace
