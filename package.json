{
  "name": "cc-family-hub",
  "version": "0.10.1",
  "description": "Claude Code-powered family coordination hub: a planning pipeline and the hub app it publishes to",
  "type": "module",
  "bin": {
    "family-hub": "bin/family-hub.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "plan": "tsx hub/index.ts plan",
    "render": "tsx hub/index.ts render",
    "publish": "tsx hub/index.ts publish",
    "sync": "tsx hub/index.ts sync",
    "summary": "tsx hub/index.ts summary",
    "check-secrets": "node scripts/check-secrets.js",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "setup:calendars": "node tools/calendar-setup/setup.js",
    "setup:strava": "tsx scripts/setup-strava.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
